-- --- LÓGICA CORE ---
local Visuals = Instance.new("Folder", SG)
local BoneStructure = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"}, {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
    {"UpperTorso", "RightUpperArm"}, {"RightUpperArm", "RightLowerArm"}, {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
    {"LowerTorso", "RightUpperLeg"}, {"RightUpperLeg", "RightLowerLeg"}
}

local function GetLine()
    local l = Instance.new("Frame", Visuals); l.BorderSizePixel = 0; l.BackgroundColor3 = Color3.new(1,0,0); l.AnchorPoint = Vector2.new(0.5, 0.5); l.Visible = false
    return l
end

local function GetText()
    local t = Instance.new("TextLabel", Visuals); t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1,1,1); t.Font = Enum.Font.Code; t.TextSize = 14; t.Visible = false; t.Size = UDim2.new(0,100,0,20)
    return t
end

local function GetViewportPos(worldPos)
    local v, onScreen = Camera:WorldToViewportPoint(worldPos)
    local inset = GuiService:GetGuiInset()
    return Vector2.new(v.X, v.Y - inset.Y), onScreen
end

local Cache = {}
local LockedPlayer = nil
local CurrentTargetPart = "Head"

RunService:BindToRenderStep("GeminiV1_Loop", Enum.RenderPriority.Camera.Value + 1, function()
    if dragging and dragInput and not isSliding then
        local delta = dragInput.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    if Settings.Noclip and LocalPlayer.Character then
        for _, p in pairs(LocalPlayer.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
    end

    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    
    if Settings.Aimbot then
        FOVCircle.Visible = true; FOVCircle.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
        
        -- Validar objetivo actual
        if LockedPlayer then
            local c = LockedPlayer.Character
            if not c or not c:FindFirstChild("Humanoid") or c.Humanoid.Health <= 0 then 
                LockedPlayer = nil 
            elseif c:FindFirstChild(CurrentTargetPart) then
                local part = c[CurrentTargetPart]
                local dist3D = (Camera.CFrame.Position - part.Position).Magnitude
                -- Validar distancia configurable y visibilidad (Wall Check)
                if dist3D > _G.AimbotDistance or not IsVisible(part, c) then LockedPlayer = nil end 
            end
        end

        -- Buscar nuevo objetivo si no hay uno fijado
        if not LockedPlayer then
            local closestDist = Settings.FOV
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health > 0 then
                    local targetPart = p.Character.Head
                    local dist3D = (Camera.CFrame.Position - targetPart.Position).Magnitude
                    
                    -- Límite de Studs configurable y Wall Check antes de fijar
                    if dist3D <= _G.AimbotDistance and IsVisible(targetPart, p.Character) then
                        local posRaw, onS = Camera:WorldToViewportPoint(targetPart.Position)
                        if onS then
                            local dist = (Vector2.new(posRaw.X, posRaw.Y) - screenCenter).Magnitude
                            if dist < closestDist then
                                closestDist = dist; LockedPlayer = p
                                if Settings.TargetMode == "Head" then CurrentTargetPart = "Head"
                                elseif Settings.TargetMode == "Body" then CurrentTargetPart = "UpperTorso"
                                else CurrentTargetPart = TargetParts[math.random(1, #TargetParts)] end
                            end
                        end
                    end
                end
            end
        end

        if LockedPlayer and LockedPlayer.Character and LockedPlayer.Character:FindFirstChild(CurrentTargetPart) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, LockedPlayer.Character[CurrentTargetPart].Position)
        end
    else
        FOVCircle.Visible = false; LockedPlayer = nil
    end

    -- Visuals (Mantenido igual)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local hum = char:FindFirstChild("Humanoid")
            local isAlive = hum and hum.Health > 0
            
            if not Cache[p.Name] then
                Cache[p.Name] = {Skeleton = {}, HP = GetText(), MainLine = GetLine()}
                for i=1, #BoneStructure do table.insert(Cache[p.Name].Skeleton, GetLine()) end
            end
            local data = Cache[p.Name]

            if isAlive then
                local head = char:FindFirstChild("Head")
                if head then
                    local hPos, hOn = GetViewportPos(head.Position + Vector3.new(0, 1.5, 0))
                    if Settings.HealthESP and hOn then
                        data.HP.Visible = true; data.HP.Position = UDim2.new(0, hPos.X - 50, 0, hPos.Y)
                        data.HP.Text = "HP: " .. math.floor(hum.Health)
                        data.HP.TextColor3 = Color3.fromHSV(hum.Health/100 * 0.3, 1, 1) 
                    else data.HP.Visible = false end
                end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local hrpPos, onS = GetViewportPos(hrp.Position)
                    if Settings.ESP and onS then
                        local start = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y - 30)
                        local mag = (start - hrpPos).Magnitude
                        data.MainLine.Visible = true; data.MainLine.Size = UDim2.new(0, mag, 0, 1); data.MainLine.Position = UDim2.new(0, (start.X + hrpPos.X)/2, 0, (start.Y + hrpPos.Y)/2); data.MainLine.Rotation = math.deg(math.atan2(hrpPos.Y - start.Y, hrpPos.X - start.X))
                    else data.MainLine.Visible = false end
                    for i, bone in ipairs(BoneStructure) do
                        local p1, p2 = char:FindFirstChild(bone[1]), char:FindFirstChild(bone[2])
                        if Settings.Skeleton and p1 and p2 then
                            local v1, o1 = GetViewportPos(p1.Position); local v2, o2 = GetViewportPos(p2.Position)
                            if o1 and o2 then
                                local m = (v1-v2).Magnitude; data.Skeleton[i].Visible = true; data.Skeleton[i].Size = UDim2.new(0,m,0,1); data.Skeleton[i].Position = UDim2.new(0,(v1.X+v2.X)/2, 0,(v1.Y+v2.Y)/2); data.Skeleton[i].Rotation = math.deg(math.atan2(v2.Y-v1.Y,v2.X-v1.X))
                            else data.Skeleton[i].Visible = false end
                        else data.Skeleton[i].Visible = false end
                    end
                end
                
                local h = char:FindFirstChild("G_CHAM")
                if Settings.Chams then if not h then h = Instance.new("Highlight", char); h.Name = "G_CHAM" end h.Enabled = true; h.FillColor = Color3.new(1,0,0)
                elseif h then h.Enabled = false end
            else
                data.HP.Visible = false; data.MainLine.Visible = false
                for _, l in pairs(data.Skeleton) do l.Visible = false end
            end
        end
    end
end)

