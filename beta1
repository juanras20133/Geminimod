}

local TargetParts = {"Head", "UpperTorso"}

-- --- FUNCIÓN DE VISIBILIDAD (WALL CHECK) ---
local function IsVisible(part, character)
    local rayParam = RaycastParams.new()
    rayParam.FilterType = Enum.RaycastFilterType.Exclude
    rayParam.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local rayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position).Unit * _G.AimbotDistance, rayParam)
    
    if rayResult and rayResult.Instance:IsDescendantOf(character) then
        return true
    end
    return false
end

