    b.Text = text .. ": OFF"; b.BackgroundColor3 = Color3.fromRGB(30, 30, 30); b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.Code
    b.MouseButton1Click:Connect(function()
        Settings[prop] = not Settings[prop]
        b.Text = text .. ": " .. (Settings[prop] and "ON" or "OFF")
        b.BackgroundColor3 = Settings[prop] and Color3.fromRGB(200, 0, 0) or Color3.fromRGB(30, 30, 30)
    end)
end

